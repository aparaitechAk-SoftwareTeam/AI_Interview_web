PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/ai_mock_interviews
MONGODB_DB=ai_mock_interviews
JWT_SECRET=replace-with-at-least-48-random-characters
JWT_ISSUER=aparaitech-interview-api
JWT_AUDIENCE=aparaitech-mobile
AI_PROVIDER=gemini
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:8081,exp://127.0.0.1:8081
ADMIN_USERNAME=administrator
ADMIN_PASSWORD=ChangeThisOnlyForLocalDevelopment
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASSWORD=use-an-app-password-or-smtp-password
MAIL_PROVIDER=disabled
BREVO_API_KEY=
MAIL_FROM=notifications@example.com
MAIL_FROM_NAME=Aparaitech Recruitment
MAIL_REPLY_TO=hr@example.com
CANDIDATE_PORTAL_URL=https://your-candidate-portal.example.com
SUPPORT_EMAIL=hr@example.com
SEED_DEMO=true
